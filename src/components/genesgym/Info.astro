---
import { Image } from "astro:assets";
import aboutImg from "../../assets/projects/GenesGym/landing_page_about_us.png";
import landingImg from "../../assets/projects/GenesGym/landing_page.png";
import comeToTrainIMG from "../../assets/projects/GenesGym/come_to_train.png";
import ourservices from "../../assets/projects/GenesGym/our_services.png";

const sections = [
  {
    title: "Landing Page",
    text: "Sección principal de la web, donde se muestra información general sobre Genes Gym y sus servicios.",
    image: landingImg,
    alt: "Sección principal de la web",
  },
  {
    title: "Sobre nosotros",
    text: "Sección para presentar a Genes Gym: quiénes somos, qué hacemos y qué hace especial a la comunidad.",
    image: aboutImg,
    alt: "Sección Sobre nosotros de la web",
  },
  {
    title: "Nuestros servicios",
    text: "Sección para mostrar los servicios que ofrece Genes Gym, con información sobre cada uno de ellos.",
    image: ourservices,
    alt: "Sección de nuestros servicios de la web",
  },
    {
        title: "Ven a entrenar",
        text: "Sección para invitar a los usuarios a unirse a Genes Gym y comenzar a entrenar con nosotros.",
        image: comeToTrainIMG,
        alt: "Sección de ven a entrenar de la web",
    },
];
---

<section class="info container">
  {sections.map((s) => (
    <div class="row">
      <div class="media">
        <Image src={s.image} alt={s.alt} width={800} format="webp" />
      </div>
      <div class="text">
        <h2>{s.title}</h2>
        <p>{s.text}</p>
      </div>
    </div>
  ))}
</section>

<style>
  .info {
    --accent: #e11d48;
    display: flex;
    flex-direction: column;
    gap: 5rem;
    padding-block: 5rem;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  /* alterna: las filas pares ponen la imagen a la derecha */
  .row:nth-child(even) .media { order: 2; }

  .media img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }

  .text {
    padding-left: 1.25rem;
    border-left: 3px solid var(--accent);
  }

  h2 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  p { color: var(--muted); }

  @media (max-width: 768px) {
    .row { grid-template-columns: 1fr; }
    .row:nth-child(even) .media { order: 0; }
  }
</style> 